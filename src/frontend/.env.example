# Example Environment Configuration for RF-FALCON-IDS
# Copy this file to .env.local for local development

# Backend canister ID (REQUIRED for IC deployment, OPTIONAL for static hosting)
# 
# For IC Deployment (build-time injection):
#   Get this value by running: dfx canister id backend --network ic
#   Then set it before building:
#     export VITE_BACKEND_CANISTER_ID=$(dfx canister id backend --network ic)
#     pnpm run build
# 
# For Static Hosting (runtime configuration):
#   Leave this empty during build
#   After deployment, edit /runtime-config.json in your deployed site instead
# 
# Format: xxxxx-xxxxx-xxxxx-xxxxx-xxx (IC principal format)
VITE_BACKEND_CANISTER_ID=

# Internet Identity URL
# Development: http://localhost:4943?canister=rdmx6-jaaaa-aaaaa-aaadq-cai
# Production: https://identity.ic0.app
VITE_II_URL=http://localhost:4943?canister=rdmx6-jaaaa-aaaaa-aaadq-cai

# Optional: Internet Identity derivation origin
# Only needed if using alternative domains
# VITE_II_DERIVATION_ORIGIN=

# Optional: CDN base URL for static assets
# Leave empty to serve assets from IC canister (default)
# Set to CDN origin to enable CDN delivery
# Example: VITE_ASSET_BASE_URL=https://cdn.example.com
VITE_ASSET_BASE_URL=

# DEPLOYMENT NOTES:
# 
# IC Deployment:
#   - VITE_BACKEND_CANISTER_ID is injected at BUILD TIME
#   - The build will fail if this value is present but invalid
#   - Use scripts/deploy-mainnet.sh for automated deployment
# 
# Static Hosting (cPanel, Netlify, Vercel):
#   - Build without VITE_BACKEND_CANISTER_ID (or leave empty)
#   - After deployment, edit /runtime-config.json in your deployed site
#   - Set backendCanisterId to your backend canister principal
#   - Reload the page to apply changes
# 
# See DEPLOYMENT.md for detailed instructions
