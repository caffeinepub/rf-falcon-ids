# Example Environment Variables for RF-FALCON-IDS
# Copy this file to .env.local for local development

# Backend canister ID (REQUIRED)
# 
# For local development:
#   1. Start dfx: dfx start --clean --background
#   2. Deploy backend: dfx deploy backend
#   3. Get canister ID: dfx canister id backend
#   4. Set here: VITE_BACKEND_CANISTER_ID=<canister-id>
#
# For production deployment:
#   1. Deploy to mainnet: dfx deploy backend --network ic
#   2. Get canister ID: dfx canister id backend --network ic
#   3. Export before build: export VITE_BACKEND_CANISTER_ID=$(dfx canister id backend --network ic)
#
VITE_BACKEND_CANISTER_ID=rrkah-fqaaa-aaaaa-aaaaq-cai

# Internet Identity URL
# Local development: http://localhost:4943/?canisterId=<ii-canister-id>
# Production: https://identity.ic0.app
VITE_II_URL=https://identity.ic0.app

# Optional: Internet Identity derivation origin
# Only needed if using alternative domains
# VITE_II_DERIVATION_ORIGIN=https://your-custom-domain.com

# Optional: CDN base URL for static assets
# Leave empty to serve assets from IC canister (default)
# Set to CDN origin to enable CDN delivery
# Example: VITE_ASSET_BASE_URL=https://cdn.example.com
VITE_ASSET_BASE_URL=

# NOTES:
# - Never commit .env.local to version control
# - The VITE_BACKEND_CANISTER_ID shown above is an example only
# - Production builds require this variable to be set and non-empty
# - See frontend/DEPLOYMENT.md for complete deployment instructions
