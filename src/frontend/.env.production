# Production Environment Variables for RF-FALCON-IDS
# These values MUST be injected during deployment

# Backend canister ID (REQUIRED - deployment will fail if empty)
# Get this value by running: dfx canister id backend --network ic
# Set before building: export VITE_BACKEND_CANISTER_ID=$(dfx canister id backend --network ic)
VITE_BACKEND_CANISTER_ID=

# Internet Identity URL (production)
VITE_II_URL=https://identity.ic0.app

# Optional: Internet Identity derivation origin
# Only needed if using alternative domains
# VITE_II_DERIVATION_ORIGIN=

# Optional: CDN base URL for static assets
# Leave empty to serve assets from IC canister (default)
# Set to CDN origin to enable CDN delivery
# Example: VITE_ASSET_BASE_URL=https://cdn.example.com
VITE_ASSET_BASE_URL=

# IMPORTANT NOTES:
# - VITE_BACKEND_CANISTER_ID must be set to a valid canister principal ID
# - The build process will fail with a clear error if this is missing
# - Do not commit actual canister IDs to version control
# - Inject this value in your deployment script or CI/CD pipeline
# - VITE_ASSET_BASE_URL is optional; only set if using a CDN
